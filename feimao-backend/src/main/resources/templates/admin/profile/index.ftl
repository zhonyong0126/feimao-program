<#import "../layout.ftl" as tpl>
<@tpl.layout active=active pageTitle="个人资料">
<div class="page-header"><div><h4>个人资料</h4><p class="text-muted">修改当前登录管理员的资料和密码，并查看自己的操作记录。</p></div></div>
<div class="row">
    <div class="col-lg-5 mb-4"><div class="card"><div class="card-header">账号资料</div><div class="card-body"><form id="profileForm"><div class="text-center mb-3"><img id="profileAvatar" alt="管理员头像" style="width:100px;height:100px;border-radius:50%;object-fit:cover;display:none"></div><div class="form-group"><label>登录账号</label><input class="form-control" id="username" disabled></div><div class="form-group"><label>手机号</label><input class="form-control" name="mobile" disabled></div><div class="form-group"><label>邮箱</label><input class="form-control" name="email" type="email" required></div><div class="form-group"><label>昵称</label><input class="form-control" name="nickname" required></div><div class="form-group"><label>头像地址</label><div class="upload-field"><input class="form-control" name="avatar"><button class="btn btn-secondary" type="button" onclick="uploadInto(this.previousElementSibling,false)">上传</button></div></div><div class="form-group"><label>新密码</label><input class="form-control" name="password" type="password" minlength="6" maxlength="30" placeholder="不修改请留空" autocomplete="new-password"></div><button class="btn btn-primary" type="submit">保存资料</button></form></div></div></div>
    <div class="col-lg-7 mb-4"><div class="card"><div class="card-header d-flex justify-content-between align-items-center"><span>我的操作记录</span><button class="btn btn-secondary btn-sm" id="profileRefresh" type="button">刷新</button></div><div class="card-body p-0 table-responsive"><table class="table"><thead><tr><th>编号</th><th>标题</th><th>请求地址</th><th>网络地址</th><th>创建时间</th></tr></thead><tbody id="profileLogs"><tr><td colspan="5" class="empty-state">正在加载...</td></tr></tbody></table></div><div class="card-footer resource-pagination"><span id="profileTotal">共 0 条记录</span><div><button class="btn btn-secondary btn-sm" id="profilePrev">上一页</button> <span id="profilePage">1 / 1</span> <button class="btn btn-secondary btn-sm" id="profileNext">下一页</button></div></div></div></div>
</div>
<script src="/admin/js/profile.js?v=20261006-2"></script>
</@tpl.layout>
