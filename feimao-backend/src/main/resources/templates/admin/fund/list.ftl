<#import "../layout.ftl" as tpl>
<@tpl.layout active=active pageTitle=fundTitle>
<div class="page-header"><div><h4>${fundTitle}</h4><p class="text-muted"><#if section?starts_with('cash-')>审核提现申请；通过操作会调用已配置的微信转账服务。<#else>查询业务资金变动记录。</#if></p></div><div><#if section?starts_with('cash-')><button class="btn btn-danger" id="bulkDeleteCashButton" disabled><i class="fas fa-trash"></i> 删除</button><#elseif section == 'finance-merchant' || section == 'finance-shop'><button class="btn btn-secondary" id="recycleFundButton"><i class="fas fa-recycle"></i> 回收站</button> <button class="btn btn-primary" id="addFundButton"><i class="fas fa-plus"></i> 新增</button><#elseif section == 'finance-platform' || section == 'finance-system'><button class="btn btn-secondary" id="recycleFundButton"><i class="fas fa-recycle"></i> 回收站</button> <button class="btn btn-danger" id="bulkDeleteFinanceButton" disabled><i class="fas fa-trash"></i> 删除</button><button class="btn btn-secondary" id="bulkRestoreFundButton" disabled hidden><i class="fas fa-rotate-left"></i> 恢复</button><button class="btn btn-danger" id="bulkDestroyFundButton" disabled hidden><i class="fas fa-times"></i> 彻底删除</button></#if></div></div>
<div class="card mb-4"><div class="card-body resource-toolbar" id="fundFilters"></div></div>
<#if section == 'finance-platform'>
<div class="fund-summary" id="fundSummary"><div class="card"><div class="card-body"><span>累计流水</span><strong id="moneyValue">0.00</strong></div></div><div class="card"><div class="card-body"><span>收入流水</span><strong id="inMoneyValue">0.00</strong></div></div><div class="card"><div class="card-body"><span>支出流水</span><strong id="outMoneyValue">0.00</strong></div></div><div class="card"><div class="card-body"><span>提现流水</span><strong id="cashMoneyValue">0.00</strong></div></div></div>
<#elseif section == 'finance-system'>
<div class="fund-summary" id="fundSummary"><div class="card"><div class="card-body"><span>累计收益</span><strong id="systemMoneyValue">0.00</strong></div></div></div>
<#else>
<div class="fund-summary" id="fundSummary"><div class="card"><div class="card-body"><span>筛选记录</span><strong id="totalValue">0</strong></div></div><div class="card"><div class="card-body"><span>金额合计</span><strong id="amountValue">0.00</strong></div></div></div>
</#if>
<div class="card"><div class="card-body p-0 table-responsive"><table class="table"><thead><tr id="fundHead"></tr></thead><tbody id="fundBody"><tr><td class="empty-state">正在加载...</td></tr></tbody></table></div><div class="card-footer resource-pagination"><span id="totalText">共 0 条记录</span><div><button class="btn btn-secondary btn-sm" id="prevButton">上一页</button> <span id="pageText">1 / 1</span> <button class="btn btn-secondary btn-sm" id="nextButton">下一页</button></div></div></div>
<div class="resource-mask" id="detailMask" hidden><div class="resource-editor card"><div class="card-header">资金记录详情<button class="editor-close close-detail">×</button></div><div class="card-body"><table class="table"><tbody id="detailBody"></tbody></table></div><div class="card-footer editor-actions"><button class="btn btn-secondary close-detail">关闭</button></div></div></div>
<div class="resource-mask" id="fundEditorMask" hidden><div class="resource-editor card"><div class="card-header">新增${fundTitle}<button class="editor-close close-fund-editor">×</button></div><div class="card-body"><form id="fundForm"></form></div><div class="card-footer editor-actions"><button class="btn btn-secondary close-fund-editor">取消</button><button class="btn btn-primary" id="saveFundButton">保存</button></div></div></div>
<script>window.businessFundPage = { section: '${section?js_string}', title: '${fundTitle?js_string}' };</script><script src="/admin/js/fund.js?v=20261006-7"></script>
</@tpl.layout>
