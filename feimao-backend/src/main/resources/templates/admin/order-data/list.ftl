<#import "../layout.ftl" as tpl>
<@tpl.layout active=active pageTitle=sectionTitle>
<div class="page-header"><div><h4>${sectionTitle}</h4><p class="text-muted">租售出行业务后台数据。</p></div><div><#if section == 'orders' || section == 'coupons'><button class="btn btn-danger" id="bulkDeleteButton" disabled><i class="fas fa-trash"></i> 删除</button> </#if><#if section == 'coupons'><button class="btn btn-info" id="bulkRestoreButton" hidden disabled><i class="fas fa-undo"></i> 恢复</button> <button class="btn btn-danger" id="bulkDestroyButton" hidden disabled><i class="fas fa-times"></i> 彻底删除</button> <button class="btn btn-success" id="restoreAllButton" hidden><i class="fas fa-undo"></i> 全部恢复</button> <button class="btn btn-danger" id="destroyAllButton" hidden><i class="fas fa-times"></i> 全部彻底删除</button> <button class="btn btn-secondary" id="recycleButton"><i class="fas fa-recycle"></i> 回收站</button> </#if><#if section == 'installments' || section == 'coupons'><button class="btn btn-primary" id="addButton"><i class="fas fa-plus"></i> 新增</button></#if></div></div>
<#if section == 'guests'><div class="card mb-4"><div class="card-body"><i class="fas fa-yen-sign"></i> 累计保险金额：<strong id="insureMoneyValue">0</strong></div></div></#if>
<div class="card mb-4"><div class="card-body resource-toolbar" id="filterBar"></div></div>
<div class="card"><div class="card-body p-0 table-responsive"><table class="table"><thead><tr id="dataHead"></tr></thead><tbody id="dataBody"><tr><td class="empty-state">正在加载...</td></tr></tbody></table></div><div class="card-footer resource-pagination"><span id="totalText">共 0 条记录</span><div><button class="btn btn-secondary btn-sm" id="prevButton">上一页</button> <span id="pageText">1 / 1</span> <button class="btn btn-secondary btn-sm" id="nextButton">下一页</button></div></div></div>
<div class="resource-mask" id="detailMask" hidden><div class="resource-editor card"><div class="card-header">详情<button class="editor-close close-detail">×</button></div><div class="card-body"><table class="table"><tbody id="detailBody"></tbody></table></div><div class="card-footer editor-actions"><button class="btn btn-secondary close-detail">关闭</button></div></div></div>
<#if section == 'orders'><div class="resource-mask" id="orderActionMask" hidden><div class="resource-editor card"><div class="card-header"><span id="orderActionTitle">订单操作</span><button class="editor-close close-order-action">×</button></div><div class="card-body"><form id="orderActionForm"><input type="hidden" id="orderActionId"><input type="hidden" id="orderActionType"><div class="form-group"><label>订单编号</label><input class="form-control" id="actionOrderNumber" readonly></div><div class="form-group"><label id="actionAmountLabel">支付金额</label><input class="form-control" id="actionAmount" readonly></div><div class="form-group" id="refundGroup"><label id="refundLabel">退款金额</label><input class="form-control" id="actionRefund" type="number" min="0" step="0.01" required></div><div class="form-group" id="returnTypeGroup" hidden><label>车辆情况</label><input class="form-control" value="无损还车" readonly></div><p class="text-muted" id="orderActionHint"></p></form></div><div class="card-footer editor-actions"><button class="btn btn-secondary close-order-action">取消</button><button class="btn btn-primary" id="submitOrderAction">确认</button></div></div></div></#if>
<#if section == 'guests' || section == 'installments' || section == 'coupons'><div class="resource-mask" id="editorMask" hidden><div class="resource-editor card"><div class="card-header"><span id="editorTitle">新增</span><button class="editor-close close-editor">×</button></div><div class="card-body"><form id="dataForm"></form></div><div class="card-footer editor-actions"><button class="btn btn-secondary close-editor">取消</button><button class="btn btn-primary" id="saveData">保存</button></div></div></div></#if>
<script>window.businessOrderDataPage = { section: '${section?js_string}', title: '${sectionTitle?js_string}' };</script>
<script src="/admin/js/order-data.js?v=20261006-12"></script>
</@tpl.layout>
